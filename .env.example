# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - PROYECTO MIGATO (ESTADO MONAGAS)
# ==============================================================================

# Entorno: development | production
NODE_ENV=production
PORT=8000

# Base de Datos PostgreSQL (Producción en VPS con Docker)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=migato_db
DB_USER=migato_admin
DB_PASSWORD=cambiar_por_contrasena_segura_2026
DATABASE_URL=postgresql://migato_admin:cambiar_por_contrasena_segura_2026@postgres:5432/migato_db

# Configuración de Seguridad y JWT
JWT_SECRET=super_secreto_gobernacion_monagas_cifrado_2026
SESSION_LIFETIME_HOURS=8

# Configuración Firebase (Alternativa gestionada)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=migato-monagas
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Dominio y Certificados
DOMAIN_NAME=migato.monagas.gob.ve
