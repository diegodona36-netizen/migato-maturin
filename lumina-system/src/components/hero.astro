---
// --- SECCION DE LOGICA (JS) ---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero/img_hero_01.webp';
---

<section class="relative min-h-[85vh] flex items-center justify-center px-4 sm:px-6 py-20 overflow-hidden" id="hero">
  <!-- Malla de Luces de Fondo (Cyber-Lumina Glows) -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-cyan-500/15 via-indigo-600/15 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute inset-0 bg-[#07090e]/80 -z-10"></div>
  <Image src={heroImage} alt="Fondo Tecnológico LuminaSystem" loading="eager" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover -z-20 opacity-20 filter brightness-50" />

  <div class="max-w-5xl mx-auto text-center space-y-6 relative z-10">
    <!-- Badge de Estado Luminoso -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-semibold shadow-inner">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
      </span>
      <span>SOFTWARE ENGINEERING & AUTOMATIZACIÓN EMPRESARIAL</span>
    </div>

    <!-- Gran Titular -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight leading-[1.1] max-w-4xl mx-auto text-white">
      Construimos <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">software de alto rendimiento</span> para escalar tu negocio.
    </h1>

    <!-- Subtítulo comercial y técnico -->
    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed font-normal">
      Diseñamos y desarrollamos plataformas web, aplicaciones multiplataforma y sistemas empresariales a medida con arquitecturas modernas, seguras y preparadas para operar en la nube o 100% offline.
    </p>

    <!-- Botones de Llamada a la Acción -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <a href="#contact-form-section" class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-black text-sm bg-gradient-to-r from-cyan-500 via-sky-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 shadow-xl shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5 active:scale-95 flex items-center justify-center gap-2 font-mono">
        <span>Solicitar Propuesta Técnica</span>
      </a>
      <a href="#projects-container" class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-sm bg-slate-900/90 hover:bg-slate-800 text-white border border-slate-700 hover:border-slate-600 transition-all flex items-center justify-center gap-2">
        <span>Ver Trabajos Realizados</span>
      </a>
    </div>

    <!-- Métricas de Confianza -->
    <div class="pt-10 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
      <div class="bg-slate-900/60 backdrop-blur-md border border-white/10 p-3.5 rounded-2xl text-center">
        <span class="text-xl sm:text-2xl font-black text-cyan-400 font-mono block">+99.9%</span>
        <span class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Uptime & Disponibilidad</span>
      </div>
      <div class="bg-slate-900/60 backdrop-blur-md border border-white/10 p-3.5 rounded-2xl text-center">
        <span class="text-xl sm:text-2xl font-black text-indigo-400 font-mono block">100%</span>
        <span class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Código Propio & Seguro</span>
      </div>
      <div class="bg-slate-900/60 backdrop-blur-md border border-white/10 p-3.5 rounded-2xl text-center">
        <span class="text-xl sm:text-2xl font-black text-emerald-400 font-mono block">Local-First</span>
        <span class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Soporte Cloud & Offline</span>
      </div>
      <div class="bg-slate-900/60 backdrop-blur-md border border-white/10 p-3.5 rounded-2xl text-center">
        <span class="text-xl sm:text-2xl font-black text-purple-400 font-mono block">Sprints</span>
        <span class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Entregas Continuas</span>
      </div>
    </div>
  </div>
</section>