---
// --- SECCION DE LOGICA (JS) ---
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer-container">
        <div class="footer-brand">
            <div class="logo">
                <span class="logo-text">Lumina<span class="highlight">System</span></span>
                <span class="badge">PRO</span>
            </div>
            <p class="brand-desc">
                Desarrollo de software a medida, arquitectura en la nube, sistemas ERP/CRM y automatización de procesos empresariales.
            </p>
        </div>

        <div class="footer-links">
            <h4>Navegación</h4>
            <ul>
                <li><a href="#hero">Inicio</a></li>
                <li><a href="#servicios">Servicios</a></li>
                <li><a href="#projects-container">Portafolio</a></li>
                <li><a href="#cotizador">Cotizador Interactivo</a></li>
                <li><a href="#contact-form-section">Contacto</a></li>
            </ul>
        </div>

        <div class="footer-contact">
            <h4>Contacto Directo</h4>
            <p><strong>Email:</strong> <a href="mailto:luminasystem.devs@gmail.com">luminasystem.devs@gmail.com</a></p>
            <p><strong>Atención:</strong> Maturín, Monagas & Remoto Internacional</p>
            <p class="status-indicator">
                <span class="pulse-dot"></span>
                <span>Disponibilidad inmediata para nuevos proyectos</span>
            </p>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; {year} LuminaSystem. Todos los derechos reservados.</p>
        <div class="legal-links">
            <a href="#">Privacidad</a>
            <span>•</span>
            <a href="#">Términos</a>
            <span>•</span>
            <a href="#">SLA 99.9%</a>
        </div>
    </div>
</footer>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .footer {
        background: #040609;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 4rem 1.5rem 2rem;
        color: #94a3b8;
        font-family: inherit;
    }

    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr 1.5fr;
        gap: 3rem;
        margin-bottom: 3rem;
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .logo-text {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: #00f2fe;
    }

    .badge {
        font-size: 0.65rem;
        font-family: monospace;
        font-weight: 700;
        background: rgba(0, 242, 254, 0.12);
        color: #00f2fe;
        border: 1px solid rgba(0, 242, 254, 0.3);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
    }

    .brand-desc {
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.6;
        max-width: 360px;
    }

    h4 {
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        letter-spacing: -0.01em;
    }

    ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

    a:hover {
        color: #00f2fe;
    }

    .footer-contact p {
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
        line-height: 1.5;
    }

    .footer-contact strong {
        color: #e2e8f0;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        font-size: 0.8rem !important;
        color: #34d399 !important;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
    }

    .footer-bottom {
        max-width: 1200px;
        margin: 0 auto;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.85rem;
        color: #475569;
    }

    .legal-links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .legal-links a {
        color: #475569;
        font-size: 0.85rem;
    }

    .legal-links a:hover {
        color: #94a3b8;
    }

    @media (max-width: 768px) {
        .footer-container {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .footer-bottom {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
