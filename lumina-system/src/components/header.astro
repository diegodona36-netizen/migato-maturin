---
---

<header class="header">
    <nav class="navbar">
        <a href="#hero" class="logo">
            <span class="logo-text">Lumina<span class="highlight">System</span></span>
            <span class="badge">DEV</span>
        </a>
        <ul class="nav-links">
            <li><a href="#hero">Inicio</a></li>
            <li><a href="#servicios">Servicios</a></li>
            <li><a href="#projects-container">Portafolio</a></li>
            <li><a href="#cotizador">Cotizador</a></li>
            <li><a href="#contact-form-section" class="btn-cta">Contacto</a></li>
        </ul>
    </nav>
</header>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }
    
    .header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        background: rgba(7, 9, 14, 0.85);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        width: 100%;
    }

    .navbar {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
    }

    .logo {
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .logo-text {
        color: #ffffff;
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: #00f2fe;
    }

    .badge {
        font-size: 0.65rem;
        font-family: monospace;
        font-weight: 700;
        background: rgba(0, 242, 254, 0.12);
        color: #00f2fe;
        border: 1px solid rgba(0, 242, 254, 0.3);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
    }

    .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        gap: 1.75rem;
    }

    .nav-links a {
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        color: #94a3b8;
        transition: color 0.2s ease;
    }

    .nav-links a:hover {
        color: #00f2fe;
    }

    .nav-links .btn-cta {
        color: #07090e;
        background: #00f2fe;
        padding: 0.5rem 1.2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.25);
    }

    .nav-links .btn-cta:hover {
        background: #38bdf8;
        color: #07090e;
        box-shadow: 0 0 25px rgba(0, 242, 254, 0.4);
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .navbar {
            padding: 0.85rem 1rem;
        }
        .nav-links {
            gap: 1rem;
        }
        .nav-links a {
            font-size: 0.85rem;
        }
        .nav-links li:nth-child(2),
        .nav-links li:nth-child(4) {
            display: none;
        }
    }
</style>