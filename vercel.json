{
  "redirects": [
    { "source": "/dossiers.html", "destination": "/index.html", "permanent": false },
    { "source": "/dossiers", "destination": "/index.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
